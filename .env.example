# Copy to .env and fill in. Variables already set in the environment take precedence.

# ---- Server ----
ADDR=:8080
# PostgreSQL database. The default uses the local server and your Linux login (no password):
# DATABASE_URL=postgres:///epoch
# A server with a password, or a hosted database (Supabase, Neon, Render...):
# DATABASE_URL=postgres://epoch:PASSWORD@db.example.com:5432/epoch?sslmode=require
# Most connections the server opens to the database (default 10; Supabase's free plan allows about 15).
# DB_MAX_CONNS=10
# Where backups and the small config file live. Default: ~/.local/share/epoch-school on Linux.
# EPOCH_DATA_DIR=/srv/epoch
# An SQLite database from an earlier version. On first start with an empty PostgreSQL
# database it is copied in automatically (the file itself is not changed).
# DB_PATH=/srv/epoch/epoch.db
TZ=Asia/Colombo
DEFAULT_COUNTRY_CODE=94
# Set to true when serving over HTTPS
SECURE_COOKIE=false

# ---- First admin account (created only on first run, when the database is empty) ----
ADMIN_EMAIL=admin@epoch.lk
# Required for a real school: at least 8 characters. The server will not start without it.
ADMIN_PASSWORD=
# true creates a demo school (teachers, parents, students, fees...) where every account uses the password epoch123.
SEED_DEMO=false

# ---- AI (Google Gemini) ----
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.8-flash is fast and low-cost; gemini-4-argon is the most capable (paid tier only).
AI_MODEL=gemini-3.8-flash

# ---- Web Push (phone notifications while the app is closed) ----
# Generate a stable pair with: go run ./cmd/generate-vapid
# Keep WEBPUSH_PRIVATE_KEY secret. Push requires the site to be served over HTTPS.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=epochadminlk@gmail.com

# ---- SMS: log | notifylk | twilio | webhook ----
SMS_PROVIDER=log
# Notify.lk (Sri Lanka) — https://notify.lk
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
# Generic HTTP gateway: receives POST {"to":"9477...","message":"..."}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- WhatsApp: log | meta | twilio | waapi ----
WHATSAPP_PROVIDER=log
# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved template with one body parameter {{1}} (needed for messages outside the 24h window)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# waapi.app: links an ordinary WhatsApp number by QR code (unofficial; use a dedicated school SIM)
WAAPI_TOKEN=
WAAPI_INSTANCE_ID=

# ---- Twilio (SMS and/or WhatsApp) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
