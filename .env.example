# Copy to .env and fill in. Variables already set in the environment take precedence.

# ---- Server ----
ADDR=:8080
DB_PATH=data/epoch.db
TZ=Asia/Colombo
DEFAULT_COUNTRY_CODE=94
# Set to true when serving over HTTPS
SECURE_COOKIE=false

# ---- First admin account (created only on first run, when the database is empty) ----
ADMIN_EMAIL=admin@epoch.lk
ADMIN_PASSWORD=change-me-now
# Create a demo school (teachers, parents, students, fees...). Set false for a real school.
SEED_DEMO=true

# ---- AI (Claude) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- SMS: log | notifylk | twilio | webhook ----
SMS_PROVIDER=log
# Notify.lk (Sri Lanka) — https://notify.lk
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO
# Generic HTTP gateway: receives POST {"to":"9477...","message":"..."}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---- WhatsApp: log | meta | twilio ----
WHATSAPP_PROVIDER=log
# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved template with one body parameter {{1}} (needed for messages outside the 24h window)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---- Twilio (SMS and/or WhatsApp) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
